# Copy this file to ".env.local" (same folder) and fill in your real value.
# ".env.local" is already excluded from Git via .gitignore, so your real
# key will never be committed or pushed to GitHub.

# Your Anthropic API key, from https://console.anthropic.com
# Required for the AI Assistant (Phase 2) to work.
ANTHROPIC_API_KEY=your-api-key-here
